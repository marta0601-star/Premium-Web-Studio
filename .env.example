# =====================================================
# iPremium Scan — environment variables (example)
# Copy to .env and fill in real values. NEVER commit .env.
# =====================================================

# --- App login gate ---
# Single shared password for the web UI. MUST be set on Railway,
# otherwise login is impossible (server returns 500).
APP_PASSWORD=change-me-in-production

# Cookie signing key for the session cookie. Use ≥32 random bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it the server falls back to a per-process random key, so
# every restart invalidates all sessions.
COOKIE_SECRET=change-me-random-string

# --- Allegro OAuth ---
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
# Optional override of the redirect URI (otherwise inferred from request).
# ALLEGRO_REDIRECT_URI=https://your-domain.example/auth/allegro/callback

# --- Token storage ---
# Path on disk for OAuth user tokens. On Railway point at the persistent
# volume so tokens survive redeploy: TOKEN_STORE_PATH=/data/tokens.json
# TOKEN_STORE_PATH=

# --- Seller defaults (fallback when Settings PUT hasn't been called) ---
# SELLER_CITY=
# SELLER_POSTCODE=
# SELLER_STATE=

# --- Server ---
# Railway sets PORT automatically. For local dev:
PORT=3000

# Production builds set NODE_ENV=production via the Dockerfile run env.
# NODE_ENV=production
